{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://veyra.dev/schemas/v50/request.schema.json",
    "title": "VEYRA v5.0 Verification Request",
    "type": "object",
    "required": [
        "worker_id",
        "release_id",
        "artifact_path",
        "expected_sha256",
        "verifiers"
    ],
    "additionalProperties": false,
    "properties": {
        "worker_id": {
            "type": "string",
            "minLength": 1
        },
        "release_id": {
            "type": "string",
            "minLength": 1
        },
        "artifact_path": {
            "type": "string",
            "minLength": 1
        },
        "expected_sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
        },
        "verifiers": {
            "type": "array",
            "minItems": 1,
            "items": {
                "enum": [
                    "cosign",
                    "syft",
                    "grype",
                    "tuf-client",
                    "spiffe-verifier",
                    "aibom-validator",
                    "trajectory-validator"
                ]
            }
        },
        "cosign_key": {
            "type": "string",
            "minLength": 1
        },
        "cosign_bundle": {
            "type": "string",
            "minLength": 1
        }
    }
}