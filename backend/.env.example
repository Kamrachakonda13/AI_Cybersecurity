DATABASE_URL=postgresql+psycopg://aegisx:aegisx@postgres:5432/aegisx
CORS_ORIGINS=http://localhost:3000
APP_ENV=development

AEGISX_ADMIN_TOKEN=change-me-in-production
# Required for high-impact pentest tooling (second privileged-admin gate)
AEGISX_PRIVILEGED_ADMIN_TOKEN=change-me-in-production-too
# Isolated worker authentication/signing. Use a secrets manager in production.
AEGISX_WORKER_TOKEN=change-me-worker-token
AEGISX_WORKER_SIGNING_SECRET=change-me-signing-secret

# Authenticated internal-agent gateway token
AEGISX_AI_GATEWAY_TOKEN=change-me-ai-gateway
# v2.5 identity bootstrap — set only for first startup, then remove/rotate securely
AEGISX_SUDO_USERNAME=sudo.admin
AEGISX_SUDO_PASSWORD=replace-with-a-strong-12-plus-character-password
AEGISX_SESSION_HOURS=8
# v2.6 tool-access approvals: pre-configured sudo inbox for access-request email.
# When SMTP_* are set, requests are emailed; otherwise they land in the sudo
# inbox panel (User & Permissions → Approval inbox) and the backend log.
AEGISX_ADMIN_EMAIL=security-admin@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=aegisx@example.com
SMTP_TLS=true
