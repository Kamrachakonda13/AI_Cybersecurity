DATABASE_URL=postgresql+psycopg://veyra:veyra@postgres:5432/veyra
CORS_ORIGINS=http://localhost:3000
APP_ENV=development

VEYRA_ADMIN_TOKEN=change-me-in-production
# Required for high-impact pentest tooling (second privileged-admin gate)
VEYRA_PRIVILEGED_ADMIN_TOKEN=change-me-in-production-too
# Isolated worker authentication/signing. Use a secrets manager in production.
VEYRA_WORKER_TOKEN=change-me-worker-token
VEYRA_WORKER_SIGNING_SECRET=change-me-signing-secret

# Authenticated internal-agent gateway token
VEYRA_AI_GATEWAY_TOKEN=change-me-ai-gateway
# v2.5 identity bootstrap — set only for first startup, then remove/rotate securely
VEYRA_SUDO_USERNAME=sudo.admin
VEYRA_SUDO_PASSWORD=replace-with-a-strong-12-plus-character-password
VEYRA_SESSION_HOURS=8
# v2.6 tool-access approvals: pre-configured sudo inbox for access-request email.
# When SMTP_* are set, requests are emailed; otherwise they land in the sudo
# inbox panel (User & Permissions → Approval inbox) and the backend log.
VEYRA_ADMIN_EMAIL=security-admin@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=veyra@example.com
SMTP_TLS=true
